---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { getProjects } from '../../lib/content';

export const getStaticPaths = (async () => {
	const projects = await getProjects();
	const link = (project?: (typeof projects)[number]) =>
		project && { href: `/projects/${project.id}/`, title: project.data.title };

	return projects.map((project, index) => ({
		params: { slug: project.id },
		props: { project, previous: link(projects[index - 1]), next: link(projects[index + 1]) },
	}));
}) satisfies GetStaticPaths;

const { project, previous, next } = Astro.props;
const { Content } = await render(project);
---
<ProjectLayout {...project.data} previous={previous} next={next}>
	<Content />
</ProjectLayout>
