---
import ListLayout from '../../layouts/ListLayout.astro';
import { getPosts, formatDate } from '../../lib/content';

const posts = await getPosts();
---
<ListLayout heading="Blog">
	{posts.length === 0 ? (
		<p class="text-2xl font-medium tracking-[-0.02em] text-gray-600 md:text-4xl">No posts yet.</p>
	) : (
		<ol>
			{posts.map((post) => (
				<li>
					<a
						href={`/blog/${post.id}/`}
						class="grid gap-y-2 py-6 transition-opacity hover:opacity-60 focus-visible:opacity-60 md:grid-cols-[10rem_1fr] md:gap-x-4 md:py-8"
					>
						<time datetime={post.data.date.toISOString()} class="text-[13px] tabular-nums text-gray-600">{formatDate(post.data.date)}</time>
						<div>
							<h2 class="text-2xl font-semibold leading-[1.05] tracking-[-0.02em] md:text-4xl">{post.data.title}</h2>
							{post.data.summary && <p class="mt-3 max-w-2xl text-[15px] text-gray-600">{post.data.summary}</p>}
						</div>
					</a>
				</li>
			))}
		</ol>
	)}
</ListLayout>
