---
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import EntryNav from '../components/EntryNav.astro';
import type { Entry } from '../lib/content';

interface Props {
	title: string;
	year: number;
	tags: string[];
	summary?: string;
	previous?: Entry;
	next?: Entry;
}
const { title, year, tags, summary, previous, next } = Astro.props;
---
<BaseLayout title={`${title} · afds.me`}>
	<article class="px-6 pt-12 pb-32 text-gray-900 md:px-10 md:pt-20">
		<a href="/projects/" class="text-xs font-medium uppercase tracking-[0.08em] text-gray-600 transition-opacity hover:opacity-60">← Projects</a>

		<header class="mt-16 md:mt-24">
			<h1 class="max-w-[14em] text-[clamp(2.5rem,7vw,5.5rem)] font-medium leading-[0.98] tracking-[-0.03em] text-pretty">{title}</h1>
			{summary && <p class="mt-8 max-w-2xl text-xl leading-snug text-gray-600 md:text-2xl">{summary}</p>}
		</header>

		<div class="mt-16 grid gap-10 md:mt-24 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
			<dl class="flex gap-12 text-[13px] lg:block lg:space-y-8">
				<div>
					<dt class="text-xs font-medium uppercase tracking-[0.08em] text-gray-600">Year</dt>
					<dd class="mt-2 text-[15px] font-medium tabular-nums">{year}</dd>
				</div>
				{tags.length > 0 && (
					<div>
						<dt class="text-xs font-medium uppercase tracking-[0.08em] text-gray-600">Focus</dt>
						<dd class="mt-2 text-[15px] font-medium">
							<ul class="space-y-1">
								{tags.map((tag) => <li>{tag}</li>)}
							</ul>
						</dd>
					</div>
				)}
			</dl>

			<Prose>
				<slot />
			</Prose>
		</div>

		<EntryNav label="More projects" previous={previous} next={next} />
	</article>
</BaseLayout>
