---
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import EntryNav from '../components/EntryNav.astro';
import { formatDate, type Entry } from '../lib/content';

interface Props {
	title: string;
	date: Date;
	tags: string[];
	summary?: string;
	previous?: Entry;
	next?: Entry;
}
const { title, date, tags, summary, previous, next } = Astro.props;
---
<BaseLayout title={`${title} · afds.me`}>
	<article class="px-6 pt-12 pb-32 text-gray-900 md:px-10 md:pt-20">
		<a href="/blog/" class="text-xs font-medium uppercase tracking-[0.08em] text-gray-600 transition-opacity hover:opacity-60">← Blog</a>

		<header class="mt-16 md:mt-24">
			<p class="text-[13px] font-medium uppercase tracking-[0.08em] text-gray-600">
				<time datetime={date.toISOString()}>{formatDate(date)}</time>
				{tags.length > 0 && <span> · {tags.join(' · ')}</span>}
			</p>
			<h1 class="mt-6 max-w-[14em] text-[clamp(2.5rem,7vw,5.5rem)] font-medium leading-[0.98] tracking-[-0.03em] text-pretty">{title}</h1>
			{summary && <p class="mt-8 max-w-2xl text-xl leading-snug text-gray-600 md:text-2xl">{summary}</p>}
		</header>

		<div class="mt-16 md:mt-24">
			<Prose>
				<slot />
			</Prose>
		</div>

		<EntryNav label="More posts" previous={previous} next={next} />
	</article>
</BaseLayout>
