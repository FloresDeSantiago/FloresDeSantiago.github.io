---
// Typography for rendered Markdown, so the .md files stay free of layout markup.
// A paragraph containing only images (consecutive image lines) becomes a row.
const classes = [
	'max-w-3xl text-[17px] leading-relaxed text-gray-900 md:text-lg',
	'[&_p]:mb-6',
	'[&_h2]:mt-16 [&_h2]:mb-5 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:leading-tight [&_h2]:tracking-[-0.02em] md:[&_h2]:text-3xl',
	'[&_h3]:mt-10 [&_h3]:mb-3 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:tracking-[-0.01em]',
	'[&_a]:underline [&_a]:underline-offset-4 [&_a]:transition-opacity hover:[&_a]:opacity-60',
	'[&_ul]:mb-6 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mb-2',
	'[&_blockquote]:my-10 [&_blockquote]:text-2xl [&_blockquote]:font-medium [&_blockquote]:leading-snug [&_blockquote]:tracking-[-0.02em]',
	'[&_code]:font-mono [&_code]:text-[0.9em] [&_pre]:mb-6 [&_pre]:overflow-x-auto [&_pre]:p-4 [&_pre]:text-sm [&_pre]:leading-relaxed',
	'[&_hr]:my-12 [&_hr]:text-gray-300',
	'[&_img]:block [&_img]:h-auto [&_img]:w-full',
	'[&_p:has(>img)]:flex [&_p:has(>img)]:flex-wrap [&_p:has(>img)]:items-start [&_p:has(>img)]:gap-4',
	'[&_p:has(>img)>img]:min-w-0 [&_p:has(>img)>img]:flex-[1_1_40%]',
];
---
<div class:list={classes}>
	<slot />
</div>
